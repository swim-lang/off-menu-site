{%- comment -%} Story — ported from Home.jsx (story). Base color red. {%- endcomment -%}

<section class="story" style="--c: var(--red); color: var(--red);">
  <img class="story__bg" src="{{ 'story.jpg' | asset_url }}" alt="">
  <div class="story__scrim"></div>
  <h2 class="story__head" data-reveal>The story behind the chew.</h2>
  <a class="story__btn" href="{{ routes.root_url }}pages/about">Discover the story</a>
  <div class="story__card" style="transform: rotate(10deg);">
    <span class="story__card-lbl"><span class="story__dot"></span> Now serving fiber from</span>
    <span class="story__card-serif serif">Chef-inspired flavors</span>
    <div class="story__card-rule"></div>
    <div class="story__card-fine"><span>Daily Fiber</span><span>Soft Chews</span></div>
  </div>
  {% render 'seal', shape: 'burst', size: 124, rotate: -9, label: 'Chef-led', class: 'story__seal story__seal--1' %}
</section>

{% stylesheet %}
  .story { position: relative; height: 907px; overflow: hidden; }
  .story__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .story__scrim { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(20,16,10,0.12), rgba(20,16,10,0.55)); }
  .story__head { position: absolute; left: 64px; bottom: 140px; width: 780px; max-width: 62%; z-index: 2; color: #fff; font-family: var(--serif); font-weight: 500; font-size: clamp(38px, 5vw, 64px); line-height: 1.04; }
  .story__btn { position: absolute; left: 64px; bottom: 52px; z-index: 2; background: #fff; color: #C11209; border: 2px solid #C11209; border-radius: 999px; padding: 16px 32px; font-weight: 700; font-size: 15px; letter-spacing: 0.04em; text-transform: uppercase; box-shadow: 0 7px 0 #C11209; transition: transform 0.12s ease, box-shadow 0.12s ease; }
  .story__btn:hover { transform: translateY(7px); box-shadow: 0 0 0 #C11209; }
  .story__card { position: absolute; top: 96px; right: 60px; z-index: 2; width: 288px; display: flex; flex-direction: column; align-items: center; gap: 12px; background: #fff; border: 2px solid #C11209; border-radius: 18px; padding: 22px 20px; color: #C11209; box-shadow: 5px 5px 0 #C11209; }
  .story__card-lbl { font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; }
  .story__card-serif { font-size: 20px; }
  .story__card-rule { width: 100%; height: 0; border-top: 1.5px dashed #C11209; }
  .story__card-fine { display: flex; flex-direction: column; align-items: center; gap: 3px; font-size: 14px; letter-spacing: 0.04em; }
  .story__dot { display: inline-block; width: 9px; height: 9px; border-radius: 999px; background: currentColor; vertical-align: middle; margin-right: 3px; animation: story-blink 1.2s step-end infinite; }
  @keyframes story-blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  .story__seal { position: absolute; z-index: 2; }
  .story__seal--1 { top: 304px; right: 142px; }
  @media (max-width: 1000px) { .story__head { max-width: 80%; } }
  @media (max-width: 640px) {
    .story { height: 440px; }
    .story__card { display: none; }
    .story__head { left: 22px; right: 22px; width: auto; max-width: none; bottom: 126px; text-align: center; font-size: clamp(28px, 7.5vw, 38px); }
    .story__btn { left: 0; right: 0; margin-inline: auto; width: fit-content; bottom: 60px; }
    .story__seal--1 { top: 26px; right: 20px; }
  }
{% endstylesheet %}

{% schema %}
{ "name": "Story", "settings": [], "presets": [{ "name": "Story" }] }
{% endschema %}
