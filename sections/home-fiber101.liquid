{%- comment -%} Fiber 101 — ported from Home.jsx (f101). Base color red. {%- endcomment -%}

<section class="f101" style="--c: var(--red); color: var(--red);">
  <span class="f101__eyebrow" data-reveal>Fiber 101</span>
  <h2 class="f101__head" data-reveal="big">What good fiber actually does.</h2>
  <p class="f101__intro" data-reveal>Fiber is the part of plants that keeps working as it moves through your system, and that's exactly the point. It helps keep digestion moving, feeds your gut, and supports fullness. Here's the quick version.</p>
  <div class="f101__grid">
    {%- assign f101_terms = "Soluble + insoluble|Prebiotic fiber|Regular, less bloated|Full and steady" | split: "|" -%}
    {%- assign f101_ills = "Whisk|spinach|Walking|apple" | split: "|" -%}
    {%- assign f101_bodies = "Two kinds of fiber, two jobs. Soluble fiber can help slow digestion and support fullness. Insoluble fiber adds bulk and helps keep things moving.|Some fibers act as prebiotics, meaning they help feed the good bacteria in your gut microbiome.|A steady fiber habit can support regularity and a calmer digestive routine, so fewer days feel stuck, sluggish, or bloated.|Fiber can help you feel full longer, which is one reason it belongs in the everyday wellness conversation." | split: "|" -%}
    {%- assign f101_nums = "01|02|03|04" | split: "|" -%}
    {%- for i in (0..3) -%}
      <div class="f101__card" data-reveal data-sfx-bell>
        <div class="f101__top">
          <span class="f101__badge">{% render 'ill', src: f101_ills[i] | append: '.svg', w: 40, h: 40 %}</span>
          <span class="f101__num serif">{{ f101_nums[i] }}</span>
        </div>
        <span class="f101__term">{{ f101_terms[i] }}</span>
        <p class="f101__body">{{ f101_bodies[i] }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .f101 { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 104px 40px 110px; border-bottom: 2px solid var(--c); }
  .f101__eyebrow { display: block; font-family: var(--sans); font-weight: 700; font-size: 13px; letter-spacing: 0.18em; text-transform: uppercase; }
  .f101__head { font-size: clamp(34px, 4.6vw, 54px); line-height: 1.04; text-transform: uppercase; letter-spacing: -0.01em; padding-top: 14px; }
  .f101__intro { max-width: 660px; font-size: 19px; line-height: 30px; color: var(--ink); padding-top: 16px; }
  .f101__grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 26px; max-width: 1180px; margin-top: 56px; }
  .f101__card { width: 264px; text-align: left; background: #fff; border: 2px solid var(--c); border-radius: 18px; padding: 24px 24px 28px; box-shadow: 0 7px 0 var(--c); display: flex; flex-direction: column; gap: 12px; transition: box-shadow 0.15s ease; }
  .f101__card:hover { box-shadow: 0 13px 0 var(--c); }
  .f101__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
  .f101__badge { width: 60px; height: 60px; border-radius: 999px; background: #fff; border: 2px solid var(--c); box-shadow: 0 4px 0 var(--c); display: flex; align-items: center; justify-content: center; color: var(--c); transform: rotate(-5deg); transition: transform 0.18s ease; }
  .f101__card:hover .f101__badge { transform: rotate(4deg); }
  .f101__num { font-style: italic; font-size: 34px; line-height: 1; color: var(--c); opacity: 0.32; }
  .f101__term { font-weight: 700; font-size: 19px; line-height: 1.1; text-transform: uppercase; letter-spacing: -0.01em; }
  .f101__body { font-size: 14px; line-height: 1.5; color: var(--ink); }
{% endstylesheet %}

{% schema %}
{ "name": "Fiber 101", "settings": [], "presets": [{ "name": "Fiber 101" }] }
{% endschema %}
