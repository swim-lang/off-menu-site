{% layout none %}
{%- comment -%}
  Password splash — standalone page (no site header/footer). Logo, password
  field, enter. Brand red on white, sticker-style button, houndstooth strip.
{%- endcomment -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>{{ shop.name }}</title>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <style>
    html, body { height: 100%; }
    body.pw { background: #fff; color: var(--red); }
    .pw__wrap {
      min-height: 100svh;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 34px; padding: 40px 24px 96px; box-sizing: border-box; text-align: center;
    }
    .pw__logo { width: min(320px, 78vw); height: auto; }
    .pw__form { display: flex; flex-direction: column; align-items: center; gap: 14px; }
    .pw__row { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
    .pw__input {
      width: min(300px, 72vw); box-sizing: border-box;
      border: 2px solid var(--red); border-radius: 999px; background: #fff;
      padding: 15px 24px; font-family: var(--sans); font-weight: 500; font-size: 16px;
      color: var(--red); outline: none; text-align: center; letter-spacing: 0.08em;
    }
    .pw__input::placeholder { color: var(--red); opacity: 0.45; letter-spacing: 0.04em; }
    .pw__input:focus { box-shadow: 0 0 0 3px rgba(193, 18, 9, 0.15); }
    .pw__btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      border: 2px solid var(--red); border-radius: 999px; background: #fff; color: var(--red);
      padding: 15px 30px; font-weight: 700; font-size: 14px; letter-spacing: 0.06em;
      text-transform: uppercase; box-shadow: 0 5px 0 var(--red);
      transition: transform 0.12s ease, box-shadow 0.12s ease;
    }
    .pw__btn:hover { transform: translateY(5px); box-shadow: 0 0 0 var(--red); }
    .pw__err { font-family: var(--serif); font-style: italic; font-size: 16px; color: var(--red); }
    .pw__hounds {
      position: fixed; left: 0; bottom: 0; width: 100%; height: 40px;
      background-repeat: no-repeat; background-size: cover; background-position: center;
    }
    @media (max-width: 640px) {
      .pw__row { flex-direction: column; width: min(300px, 82vw); }
      .pw__input, .pw__btn { width: 100%; }
    }
  </style>
</head>
<body class="pw">
  <main class="pw__wrap">
    <img class="pw__logo" src="{{ 'Logo-clean-red.svg' | asset_url }}" alt="{{ shop.name }}">

    {% form 'storefront_password', class: 'pw__form' %}
      {%- if form.errors -%}
        <p class="pw__err">That's not it. Ask the chef and try again.</p>
      {%- endif -%}
      <div class="pw__row">
        <input class="pw__input" type="password" name="password" placeholder="Password" autocomplete="current-password" autofocus required>
        <button class="pw__btn" type="submit">Enter &rarr;</button>
      </div>
    {% endform %}
  </main>
  <div class="pw__hounds" style="background-image: url({{ 'PatternNEW-c11209.svg' | asset_url }});"></div>
</body>
</html>
