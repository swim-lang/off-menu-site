{%- comment -%} FAQ page — magenta color-on-white. Ported from React FAQ.jsx/FAQ.css. {%- endcomment -%}

{%- comment -%} HERO {%- endcomment -%}
<section class="faq-hero">
  <span class="faq-eyebrow" data-reveal>Help · FAQ</span>
  <h1 class="faq-hero__head" data-reveal="big">Frequently asked questions</h1>
  <p class="faq-hero__sub" data-reveal>Everything about the chews, your routine, and what's inside.</p>
</section>

{%- comment -%} BODY {%- endcomment -%}
<section class="faq-body">
  <div class="faq-grid">
    <div class="faq-col">

      {%- comment -%} PRODUCT group — first item starts open {%- endcomment -%}
      <div class="faq-group">
        <div class="faq-group__head" data-reveal>
          <h2 class="faq-group__title">Product</h2>
        </div>
        <div class="faq-list">
          <div class="faq-item-wrap" data-reveal>
            <div class="faq-item is-open">
              <button type="button" class="faq-q" aria-expanded="true">
                <span class="faq-q__label">What is Off Menu Daily Fiber?</span>
                <span class="faq-q__icon" aria-hidden="true">−</span>
              </button>
              <div class="faq-a-wrap"><p class="faq-a">A chef-led daily fiber soft chew, designed to support digestive health, regularity, fullness, and daily fiber intake, without powders, mixing, or capsules.</p></div>
            </div>
          </div>
          <div class="faq-item-wrap" data-reveal>
            <div class="faq-item">
              <button type="button" class="faq-q" aria-expanded="false">
                <span class="faq-q__label">Who is it for?</span>
                <span class="faq-q__icon" aria-hidden="true">+</span>
              </button>
              <div class="faq-a-wrap"><p class="faq-a">Anyone looking for an easy, repeatable way to add fiber to their daily routine without powders, mixing, or capsules.</p></div>
            </div>
          </div>
          <div class="faq-item-wrap" data-reveal>
            <div class="faq-item">
              <button type="button" class="faq-q" aria-expanded="false">
                <span class="faq-q__label">How much fiber does it have?</span>
                <span class="faq-q__icon" aria-hidden="true">+</span>
              </button>
              <div class="faq-a-wrap"><p class="faq-a">Each serving gives you 2g of fiber to help support digestive health, regularity, and fullness.</p></div>
            </div>
          </div>
          <div class="faq-item-wrap" data-reveal>
            <div class="faq-item">
              <button type="button" class="faq-q" aria-expanded="false">
                <span class="faq-q__label">How often should I take it?</span>
                <span class="faq-q__icon" aria-hidden="true">+</span>
              </button>
              <div class="faq-a-wrap"><p class="faq-a">Take two chews daily as part of your routine. Consistency is what makes fiber work. The habit matters.</p></div>
            </div>
          </div>
          <div class="faq-item-wrap" data-reveal>
            <div class="faq-item">
              <button type="button" class="faq-q" aria-expanded="false">
                <span class="faq-q__label">When should I take it?</span>
                <span class="faq-q__icon" aria-hidden="true">+</span>
              </button>
              <div class="faq-a-wrap"><p class="faq-a">Whenever it fits your day. Many people pair it with a meal or a moment they already remember, so it becomes easy to repeat.</p></div>
            </div>
          </div>
          <div class="faq-item-wrap" data-reveal>
            <div class="faq-item">
              <button type="button" class="faq-q" aria-expanded="false">
                <span class="faq-q__label">How soon will I feel it?</span>
                <span class="faq-q__icon" aria-hidden="true">+</span>
              </button>
              <div class="faq-a-wrap"><p class="faq-a">Everyone is different. Fiber works best as a daily habit over time rather than as a one-off, so give your routine a few weeks.</p></div>
            </div>
          </div>
          <div class="faq-item-wrap" data-reveal>
            <div class="faq-item">
              <button type="button" class="faq-q" aria-expanded="false">
                <span class="faq-q__label">Should I drink water with it?</span>
                <span class="faq-q__icon" aria-hidden="true">+</span>
              </button>
              <div class="faq-a-wrap"><p class="faq-a">Staying hydrated is always a good idea and helps fiber do its job, so enjoy your chew with a glass of water when you can.</p></div>
            </div>
          </div>
          <div class="faq-item-wrap" data-reveal>
            <div class="faq-item">
              <button type="button" class="faq-q" aria-expanded="false">
                <span class="faq-q__label">Can I take an extra serving?</span>
                <span class="faq-q__icon" aria-hidden="true">+</span>
              </button>
              <div class="faq-a-wrap"><p class="faq-a">One serving is plenty for most people. We made the chews so you can have more through the day if you like, and since everyone is different, take as much as feels right for you.</p></div>
            </div>
          </div>
          <div class="faq-item-wrap" data-reveal>
            <div class="faq-item">
              <button type="button" class="faq-q" aria-expanded="false">
                <span class="faq-q__label">Is this a laxative?</span>
                <span class="faq-q__icon" aria-hidden="true">+</span>
              </button>
              <div class="faq-a-wrap"><p class="faq-a">No. Off Menu is a daily fiber supplement designed to support digestive health and regularity, not a laxative.</p></div>
            </div>
          </div>
          <div class="faq-item-wrap" data-reveal>
            <div class="faq-item">
              <button type="button" class="faq-q" aria-expanded="false">
                <span class="faq-q__label">Does it replace eating fiber-rich foods?</span>
                <span class="faq-q__icon" aria-hidden="true">+</span>
              </button>
              <div class="faq-a-wrap"><p class="faq-a">No. It is a supplement to support your daily fiber intake, meant to complement a balanced diet of fiber-rich foods, not replace it.</p></div>
            </div>
          </div>
          <div class="faq-item-wrap" data-reveal>
            <div class="faq-item">
              <button type="button" class="faq-q" aria-expanded="false">
                <span class="faq-q__label">Is this medical advice?</span>
                <span class="faq-q__icon" aria-hidden="true">+</span>
              </button>
              <div class="faq-a-wrap"><p class="faq-a">No. Off Menu is a dietary supplement, not medical advice or treatment. If you are pregnant, nursing, managing a medical condition, taking medication, or have questions about fiber, check with your healthcare provider.</p></div>
            </div>
          </div>
        </div>
      </div>

      {%- comment -%} INGREDIENTS & FLAVOR group {%- endcomment -%}
      <div class="faq-group">
        <div class="faq-group__head" data-reveal>
          <h2 class="faq-group__title">Ingredients &amp; Flavor</h2>
        </div>
        <div class="faq-list">
          <div class="faq-item-wrap" data-reveal>
            <div class="faq-item">
              <button type="button" class="faq-q" aria-expanded="false">
                <span class="faq-q__label">Why chef-inspired flavors?</span>
                <span class="faq-q__icon" aria-hidden="true">+</span>
              </button>
              <div class="faq-a-wrap"><p class="faq-a">Function gets you to buy it. Flavor gets you to come back. We work on flavor like a kitchen would, so a daily habit feels like a treat.</p></div>
            </div>
          </div>
          <div class="faq-item-wrap" data-reveal>
            <div class="faq-item">
              <button type="button" class="faq-q" aria-expanded="false">
                <span class="faq-q__label">Is this candy?</span>
                <span class="faq-q__icon" aria-hidden="true">+</span>
              </button>
              <div class="faq-a-wrap"><p class="faq-a">No. It is a fiber supplement that happens to taste good. The chew format is just the easiest way to make fiber a habit you keep.</p></div>
            </div>
          </div>
          <div class="faq-item-wrap" data-reveal>
            <div class="faq-item">
              <button type="button" class="faq-q" aria-expanded="false">
                <span class="faq-q__label">Is it vegan?</span>
                <span class="faq-q__icon" aria-hidden="true">+</span>
              </button>
              <div class="faq-a-wrap"><p class="faq-a">Yes. Off Menu is vegan.</p></div>
            </div>
          </div>
          <div class="faq-item-wrap" data-reveal>
            <div class="faq-item">
              <button type="button" class="faq-q" aria-expanded="false">
                <span class="faq-q__label">Is it gluten-free?<span class="faq-tag">TBD</span></span>
                <span class="faq-q__icon" aria-hidden="true">+</span>
              </button>
              <div class="faq-a-wrap"><p class="faq-a">We are still finalizing this. Full details will be confirmed on the label and here soon.</p></div>
            </div>
          </div>
          <div class="faq-item-wrap" data-reveal>
            <div class="faq-item">
              <button type="button" class="faq-q" aria-expanded="false">
                <span class="faq-q__label">Does it contain allergens?<span class="faq-tag">TBD</span></span>
                <span class="faq-q__icon" aria-hidden="true">+</span>
              </button>
              <div class="faq-a-wrap"><p class="faq-a">We are still finalizing this. Always check the most recent label for the full ingredient and allergen information.</p></div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <aside class="faq-rail">
      {% render 'seal', shape:'scallop', size:168, label:'Off Menu', class:'faq-seal' %}
      {% render 'ill', src:'apple.svg', w:96, h:126, class:'faq-rail__ill faq-rail__ill--apple' %}
      {% render 'ill', src:'grape.svg', w:120, h:120, class:'faq-rail__ill faq-rail__ill--grape' %}
      <div class="faq-card" data-reveal>
        <div class="faq-card__title serif">Still have questions?</div>
        <p class="faq-card__sub">We're happy to help. Drop us a note.</p>
        <a href="{{ routes.root_url }}pages/contact" class="faq-card__btn">Contact us</a>
      </div>
      {% render 'ill', src:'Carrot.svg', w:115, h:126, class:'faq-rail__ill faq-rail__ill--carrot' %}
    </aside>
  </div>
</section>

{% stylesheet %}
/* FAQ — magenta (#86335F) color-on-white. White bg, C headings/borders, ink body. */

.serif { font-family: var(--serif); font-style: italic; }

/* HERO */
.faq-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 16px;
  padding: 130px 48px 110px;
  background: #fff;
}
.faq-eyebrow {
  display: block;
  font-weight: 500;
  font-size: 13px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}
.faq-hero__head {
  font-size: clamp(38px, 6vw, 56px);
  line-height: 1.0;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  max-width: 18ch;
}
.faq-hero__sub {
  font-size: 17px;
  line-height: 1.55;
  color: var(--ink);
  max-width: 540px;
}

/* BODY */
.faq-body { background: #fff; padding: 0 48px 120px; }
.faq-grid {
  display: flex;
  gap: 56px;
  max-width: 1040px;
  margin: 0 auto;
  align-items: flex-start;
}
.faq-col { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 44px; }

/* GROUP */
.faq-group { display: flex; flex-direction: column; gap: 12px; }
.faq-group__head { margin-bottom: 6px; padding-bottom: 8px; border-bottom: 2px solid var(--c); }
.faq-group__title {
  font-size: 24px;
  line-height: 1.25;
  text-transform: uppercase;
  letter-spacing: -0.005em;
}
.faq-list { display: flex; flex-direction: column; gap: 12px; }
.faq-item-wrap { width: 100%; }

/* ACCORDION ITEM — white card, C border, C offset shadow */
.faq-item {
  border: 2px solid var(--c);
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 4px 0 var(--c);
  overflow: hidden;
}
.faq-q {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 16px 20px;
  background: transparent;
  border: 0;
  cursor: pointer;
  text-align: left;
  font: inherit;
}
.faq-q__label {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 700;
  font-size: 16px;
  line-height: 1.25;
  color: var(--c);
}
.faq-q__icon {
  flex-shrink: 0;
  font-weight: 500;
  font-size: 22px;
  line-height: 1;
  color: var(--c);
}
.faq-tag {
  flex-shrink: 0;
  border-radius: 4px;
  padding: 3px 7px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #fff;
  background: var(--c);
}
.faq-a-wrap { overflow: hidden; }
.faq-a {
  padding: 2px 20px 18px;
  font-weight: 500;
  font-size: 15px;
  line-height: 1.6;
  color: var(--ink);
}

/* ILLUSTRATION RAIL */
.faq-rail {
  flex: 0 0 280px;
  width: 280px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40px;
  color: var(--c);
}
.faq-seal { flex-shrink: 0; }
.faq-rail__ill { flex-shrink: 0; }

/* STILL HAVE QUESTIONS card */
.faq-card {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 26px 24px;
  border: 2px solid var(--c);
  border-radius: 16px;
  background: #fff;
  text-align: center;
}
.faq-card__title { font-size: 18px; line-height: 1.2; color: var(--c); }
.faq-card__sub { font-size: 14px; line-height: 1.4; letter-spacing: 0.02em; color: var(--ink); }
.faq-card__btn {
  margin-top: 6px;
  width: 100%;
  padding: 11px 22px;
  border: 2px solid var(--c);
  border-radius: 999px;
  background: #fff;
  box-shadow: 0 5px 0 var(--c);
  color: var(--c);
  font: inherit;
  font-weight: 500;
  font-size: 13px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  cursor: pointer;
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}
.faq-card__btn:hover { transform: translateY(5px); box-shadow: 0 0 0 var(--c); }
.faq-card__btn:active { transform: translateY(5px); box-shadow: 0 0 0 var(--c); }

@media (max-width: 860px) {
  .faq-hero { padding: 96px 24px 72px; }
  .faq-body { padding: 0 24px 80px; }
  .faq-grid { flex-direction: column; gap: 48px; }
  .faq-rail { order: 2; flex-basis: auto; width: 100%; max-width: 360px; margin: 0 auto; }
}

/* Accordion open/close animation (replaces Framer height animation) */
.faq-a-wrap { overflow: hidden; max-height: 0; transition: max-height .34s ease; }
.faq-item.is-open .faq-a-wrap { max-height: 400px; }

@media (max-width: 640px) {
  .faq-hero__sub { font-size: 15px; }
  .faq-seal { display: none; }
  .faq-rail__ill--apple,
  .faq-rail__ill--grape { display: none !important; }
  .faq-rail { gap: 28px; }
  .faq-rail__ill--carrot { order: 1; }
  .faq-card { order: 2; }
}
{% endstylesheet %}

<script>
  (function () {
    document.querySelectorAll('.faq-q').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var item = btn.closest('.faq-item');
        if (!item) return;
        var open = item.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        var icon = btn.querySelector('.faq-q__icon');
        if (icon) icon.textContent = open ? '−' : '+';
      });
    });
  })();
</script>

{% schema %}
{
  "name": "FAQ",
  "settings": [],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
